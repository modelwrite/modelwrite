      "name": "Cup Detection",
      "kind": "requirement",
      "reqId": "PR-2",
      "reqText": "The robot shall detect a dropped coffee cup on the floor within 2 metres at any point on its route.",
      "stereotypes": [
        "Requirement"
      ],
      "attributes": [],
      "documentation": ""
    },
    {
      "id": "req-collect",
      "name": "Cup Collection",
      "kind": "requirement",
      "reqId": "PR-3",
      "reqText": "The robot shall collect a detected cup without stopping its route and without contacting the cup with its wheels.",
      "stereotypes": [
        "Requirement"
      ],
      "attributes": [],
      "documentation": ""
    },
    {
      "id": "req-privacy",
      "name": "Camera Privacy",
      "kind": "requirement",
      "reqId": "PR-4",
      "reqText": "The robot shall transmit no image off the device and shall not retain imagery identifying a customer; detection shall produce a cup position, not a recording.",
      "stereotypes": [
        "Requirement"
      ],
      "attributes": [],
      "documentation": "A camera robot working around the public is a data-protection question before it is an engineering one."
    },
    {
      "id": "req-yield",
      "name": "Yield to People",
      "kind": "requirement",
      "reqId": "PR-5",
      "reqText": "The robot shall stop and yield when a person is within 1 metre, and shall not resume until the person has moved away.",
      "stereotypes": [
        "Requirement"
      ],
      "attributes": [],
      "documentation": ""
    },
    {
      "id": "req-noise",
      "name": "Service Undisturbed",
      "kind": "requirement",
