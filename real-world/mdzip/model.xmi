	<MD_Customization_for_SysML__additional_stereotypes:PartProperty xmi:id='_2026x_1_12a70364_1789364318281_240408_3751_application' base_Property='_2026x_1_12a70364_1789364318281_240408_3751'/>
	<MD_Customization_for_SysML__additional_stereotypes:PartProperty xmi:id='_2026x_1_12a70364_1789364324701_189881_3755_application' base_Property='_2026x_1_12a70364_1789364324701_189881_3755'/>
	<MD_Customization_for_SysML__additional_stereotypes:PartProperty xmi:id='_2026x_1_12a70364_1789364331102_943220_3759_application' base_Property='_2026x_1_12a70364_1789364331102_943220_3759'/>
	<MD_Customization_for_SysML__additional_stereotypes:PartProperty xmi:id='_2026x_1_12a70364_1789364337942_820887_3763_application' base_Property='_2026x_1_12a70364_1789364337942_820887_3763'/>
	<MD_Customization_for_SysML__additional_stereotypes:ReferenceProperty xmi:id='_2026x_1_12a70364_1789608287539_504372_6123_application' base_Property='_2026x_1_12a70364_1789608287539_504372_6123'/>
	<MagicDraw_Profile:DiagramInfo xmi:id='_2026x_1_12a70364_1789521685900_963196_5603_' base_Diagram='_2026x_1_12a70364_1789521685900_963196_5603' Creation_date='9/16/26, 11:21 AM' Modification_date='9/16/26, 11:21 AM' Author='vdiuser10' Last_modified_by='vdiuser10'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470201_737876_5617_' base_Class='_2026x_1_12a70364_1789522470201_737876_5617' Id='1'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470210_613186_5619_' base_Class='_2026x_1_12a70364_1789522470210_613186_5619' Id='1.1' Text='The boiler shall heat water to 84°C within 90 seconds of turning on the coffee machine'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470213_487063_5622_' base_Class='_2026x_1_12a70364_1789522470213_487063_5622' Id='1.2' Text='The thermostat shall stop all power supply if the instantaneous water heater exceeds 170°C'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470217_232543_5625_' base_Class='_2026x_1_12a70364_1789522470217_232543_5625' Id='1.3' Text='The water tank will not brew coffee if there is less than 500mL of water'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470220_757311_5628_' base_Class='_2026x_1_12a70364_1789522470220_757311_5628' Id='1.4' Text='The grinder will not grind coffee beans if there is less than 45g of beans within the bean container'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470227_43173_5631_' base_Class='_2026x_1_12a70364_1789522470227_43173_5631' Id='1.5' Text='The water tank shall be able to hold a max capacity of 2.4L'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470229_653956_5634_' base_Class='_2026x_1_12a70364_1789522470229_653956_5634' Id='1.6' Text='The coffee bean container shall be able to store a max weight of 300g of coffee beans'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470232_505575_5637_' base_Class='_2026x_1_12a70364_1789522470232_505575_5637' Id='1.7' Text='The grounds draw can store a max waste capacity of 8 grounds before it is deemed full'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470236_795679_5640_' base_Class='_2026x_1_12a70364_1789522470236_795679_5640' Id='1.8' Text='The pump presser shall not be greater than 15 bar'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470238_822356_5643_' base_Class='_2026x_1_12a70364_1789522470238_822356_5643' Id='1.9' Text='The coffee machine will perform a system check to confirm coffee beans and water levels are satisfied before a coffee is made'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470240_748943_5646_' base_Class='_2026x_1_12a70364_1789522470240_748943_5646' Id='1.10' Text='The coffee machine will alert to user of a system check to be addressed'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470243_75877_5649_' base_Class='_2026x_1_12a70364_1789522470243_75877_5649' Id='1.11' Text='The coffee machine shall have a digital display which the user can make selections with ease'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470246_238622_5652_' base_Class='_2026x_1_12a70364_1789522470246_238622_5652' Id='2'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470249_829935_5654_' base_Class='_2026x_1_12a70364_1789522470249_829935_5654' Id='2.1' Text='The maintenance operator shall clean the brewing unit once a week'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470251_936773_5657_' base_Class='_2026x_1_12a70364_1789522470251_936773_5657' Id='2.2' Text='The maintenance operator shall clean the exterior only using water and kitchen detergent'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470252_176734_5660_' base_Class='_2026x_1_12a70364_1789522470252_176734_5660' Id='2.3' Text='The maintenance operator shall clean the water tank 1 time per week'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470268_212057_5663_' base_Class='_2026x_1_12a70364_1789522470268_212057_5663' Id='3'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470269_5755_5665_' base_Class='_2026x_1_12a70364_1789522470269_5755_5665' Id='3.1'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470270_589609_5667_' base_Class='_2026x_1_12a70364_1789522470270_589609_5667' Id='3.1.1' Text='If the gearmotor overloads the motors electronic system shall switchoff after 8-10s and the machine is stopped'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470271_475286_5670_' base_Class='_2026x_1_12a70364_1789522470271_475286_5670' Id='3.1.2' Text='During brewing operation if the HWS valve is opened the coffee machine shall interrupt the water flow'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470272_63721_5673_' base_Class='_2026x_1_12a70364_1789522470272_63721_5673' Id='3.1.3' Text='During operation if interruption occurs by the removal of the dreg draw the machine shall continue its function unrestricted once the drawer is returned'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470273_392927_5676_' base_Class='_2026x_1_12a70364_1789522470273_392927_5676' Id='3.1.4' Text='If power failure/side doors opened during operation the coffee machines gears will complete the function commenced but without brewing'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789602694801_483599_6108_' base_Class='_2026x_1_12a70364_1789602694801_483599_6108' Id='3.1.5' Text='During water dispensing the coffee machine shall electrically isolate the water path and incorporate a residual current device (RCD) so that a short circuit cannot energise the chassis or expose the operator to electric shock.'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470274_644308_5679_' base_Class='_2026x_1_12a70364_1789522470274_644308_5679' Id='3.2'/>
	<sysml:Requirement xmi:id='_2026x_1_12a70364_1789522470275_767711_5681_' base_Class='_2026x_1_12a70364_1789522470275_767711_5681' Id='3.2.1' Text='The coffee machine unit shall not be sold unless it has a RCM with the Australian standards of the AS/NZS 4417.1 and AS/NZS 4417.2'/>
	<sysml:Satisfy xmi:id='_2026x_1_12a70364_1789525729807_96460_5951_application' base_Abstraction='_2026x_1_12a70364_1789525729807_96460_5951'/>
	<sysml:Satisfy xmi:id='_2026x_1_12a70364_1789525729810_333260_5952_application' base_Abstraction='_2026x_1_12a70364_1789525729810_333260_5952'/>
