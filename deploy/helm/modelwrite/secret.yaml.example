# EXAMPLE ONLY - not installed by Helm (the .example extension is ignored by the
# template loader). Copy this to a real Secret and fill in real values with your
# secret manager (or `kubectl create secret`); never commit the filled-in copy.
#
# The chart reads these keys by NAME, all optional except that the pod will not
# start with no auth configured unless MW_ALLOW_OPEN=yes:
#   auth.tokenSecret  -> stringData.auth-token   (MW_AUTH_TOKEN)
#   auth.jwksSecret   -> stringData.jwks.json    (MW_AUTH_JWKS, mounted at /jwks)
#   database.urlSecret -> stringData.database-url (MW_DATABASE_URL)
apiVersion: v1
kind: Secret
metadata:
  name: modelwrite-secrets
type: Opaque
stringData:
  # A shared bearer token: any high-entropy string. Alternative to the JWKS.
  auth-token: "CHANGE-ME"
  # The JWKS document (public signing keys) for JWT identity. This is the
  # air-gapped identity path: ship the JWKS file alongside the image.
  jwks.json: |
    {"keys": []}
  # A libpq-style PostgreSQL URL including the password. Required for PostgreSQL;
  # omit it (and the chart's database.urlSecret) for SQLite.
  database-url: "postgres://modelwrite:CHANGE-ME@postgres:5432/modelwrite"
